# =========================
# InterVUZ backend (docker)
# Copy this file to ".env" and edit values.
# =========================

# Ports
APP_PORT=8000
HTTP_PORT=8000
POSTGRES_PORT=5432

# Database
POSTGRES_DB=intervuz
POSTGRES_USER=intervuz
POSTGRES_PASSWORD=intervuz

# Paths inside container
ROOT_IMAGE_PATH=
PLACES_DATA_PATH=/app/GEO_Json/points.json
SCHEDULE_DATA_DIR=/app/schedule/lksJSON

# External APIs
STRUCTURE_API_URL=https://lks.bmstu.ru/lks-back/api/v1/structure
SCHEDULE_GROUP_API_BASE_URL=https://lks.bmstu.ru/lks-back/api/v1/schedules/groups
STRUCTURE_TARGET_ROOT_UUID=8c1b7bb8-e690-11db-89c3-000cf1a7cbf0
NEWS_API_URL=https://api.www.bmstu.ru/news

# Sync jobs
SYNC_ON_STARTUP=false
SYNC_INTERVAL=72h
NEWS_SYNC_ENABLED=false
NEWS_SYNC_INTERVAL=24h
NEWS_SYNC_LIMIT=10

# Assistant (required if /assistant/chat is used)
ASSISTANT_BASE_URL=https://polza.ai/api/v1
ASSISTANT_API_KEY=PUT_YOUR_POLZA_KEY_HERE
ASSISTANT_MODEL=google/gemini-2.0-flash-001
ASSISTANT_TIMEOUT=30s
ASSISTANT_CONTEXT_MAX_CHARS=120000

# Required by docker-compose.yml
ACADEMIC_WEEK1_START_DATE=2026-02-09

# Timezone
TZ=Europe/Moscow
